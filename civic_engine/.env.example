# Environment Configuration for Civic Issue Discovery & Action Engine

# AI Provider: "mock", "openai", "gemini", or "anthropic"
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (default is local SQLite; supports postgresql+psycopg2://user:pass@localhost:5432/civic_db)
DATABASE_URL=sqlite:///./civic_engine.db

# Request execution settings
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# Security settings
API_AUTH_ENABLED=false
API_SECRET_KEY=civic-secret-key-change-me

# Proactive Discovery loop
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MINUTES=60
