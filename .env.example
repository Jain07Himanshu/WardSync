# ==============================================================================
# WardSync Platform Environment Configuration Template
# ==============================================================================

# AI Provider Selection: 'gemini' | 'openai' | 'anthropic' | 'mock'
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Keys (Set the one matching your AI_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration (Defaults to SQLite; use PostgreSQL for production)
DATABASE_URL=sqlite:///./civic_engine.db

# Optional Supabase Vector Database Credentials (if using cloud pgvector)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-key

# Frontend API URL (for wardsync-frontend production builds)
VITE_API_URL=https://wardsync-api.onrender.com
